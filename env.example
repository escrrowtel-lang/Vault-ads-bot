BOT_TOKEN=123456:ABCDEF
ADMIN_ID=123456789
API_ID=12345678
API_HASH=0123456789abcdef0123456789abcdef
FERNET_KEY=PASTE_FERNET_KEY_HERE
MONGO_URI=mongodb+srv://USERNAME:PASSWORD@cluster.example.mongodb.net/?retryWrites=true&w=majority
MONGO_DB=promo_bot
MEDIA_DIR=media
DEFAULT_INTERVAL_MINUTES=60
GROUP_DELAY_SECONDS=30
DM_BROADCAST_DELAY_SECONDS=60
# Account-level PeerFlood results in a 24-hour hold; this does not lift restrictions.
RESTRICTION_PAUSE_HOURS=24

# Cache TTL for normal reads. New join events update the cache immediately.
TARGET_CACHE_TTL_SECONDS=21600
# Repair missed Telegram group-join updates in the background (minimum 300s).
AUTO_GROUP_SYNC_SECONDS=600

# Incoming-DM auto reply (control bot and connected real accounts)
DM_AUTO_REPLY_ENABLED=true
ACCOUNT_DM_AUTO_REPLY_ENABLED=true
DM_REPLY_COOLDOWN_SECONDS=300
# Minimum spacing AFTER a successful incoming DM reply; never overrides an active group cooldown.
DM_REPLY_SEND_GAP_SECONDS=5
DM_AUTO_REPLY_TEXT=👋 Thanks for messaging! We'll respond soon.
ACCOUNT_DM_AUTO_REPLY_TEXT=👋 Hi! Thanks for reaching out. We will respond when available.
# true = reply to incoming real-account DMs using the saved promotion post instead of text
DM_AUTO_REPLY_USE_SAVED_POST=false

# Separate per-approved-user posts and downloaded media
OPERATORS_DIR=operators

# Bot Account group replies (Bot API accounts added from the control bot)
BOT_GROUP_REPLY_COOLDOWN_SECONDS=600
BOT_GROUP_REPLY_TEXT=👋 Thanks for your message.

# Minimum per-account interval for queued group join/request attempts. Values below 300 are clamped to 300.
JOIN_QUEUE_INTERVAL_SECONDS=300
